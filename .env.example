# PowerShell: $env:FRUISPECT_DEVICE='cpu' (the launcher reads environment variables)
FRUISPECT_DEVICE=cpu
FRUISPECT_HOST=127.0.0.1
FRUISPECT_PORT=5000
FRUISPECT_THREADS=2
FRUISPECT_RETENTION_HOURS=24
FRUISPECT_MAX_FILE_MB=12
FRUISPECT_MAX_PIXELS=24000000
FRUISPECT_MAX_BATCH=1000
FRUISPECT_MAX_QUEUE=1500
FRUISPECT_MAX_SPOOL_MB=2048
FRUISPECT_UPLOAD_SLOTS=2
# Optional phone camera link: auto-discover and start ngrok; use 0 to stay offline/local.
FRUISPECT_NGROK=auto
FRUISPECT_NGROK_TIMEOUT=20
# Optional override. Otherwise looks in the project/tools, PATH, nearby ngrok folders,
# and Desktop/Downloads.
# FRUISPECT_NGROK_PATH=C:/tools/ngrok.exe
# Required for LAN binding. Browser uses HTTP Basic: any username, token as password.
# Put LAN deployment behind HTTPS. CPU is the supported default.
# FRUISPECT_ACCESS_TOKEN=
# FRUISPECT_ARTIFACTS=D:/path/to/trained-outputs
# FRUISPECT_INSTANCE=D:/path/to/private/runtime
